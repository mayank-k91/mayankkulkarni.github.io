@article{kulkarni2026listqa,
  title     = {ListQA: A Benchmark for Evaluating List-Formatted Factual Knowledge Retrieval in Large Language Models},
  author    = {Kulkarni, Mayank and Vaideeswaran, R.},
  journal   = {NeurIPS 2026 (in submission)},
  year      = {2026},
  tags      = {evaluation, pre-training, reasoning},
  abstract  = {Standard retrieval benchmarks miss a systematic class of failure: models that can answer single-fact questions often fail when the answer requires retrieving and integrating multiple related facts. ListQA addresses this gap with a benchmark specifically designed to surface multi-fact retrieval failures, validated against held-out subsets using LLM-as-a-Judge.}
}

@inproceedings{guo2025engdesign,
  title     = {Toward Engineering AGI: Benchmarking the Engineering Design Capabilities of LLMs},
  author    = {Guo, X. and others and Kulkarni, Mayank and Namazifar, M. and Zhang, H. and Hu, B.},
  booktitle = {Advances in Neural Information Processing Systems 38},
  year      = {2025},
  tags      = {evaluation, AI for science, engineering reasoning},
  abstract  = {EngDesign is a benchmark for open-ended engineering reasoning across 9 domains — analog IC, structural, mechanical, control systems, robotics, digital hardware, OS, computer architecture, and signal processing — evaluated through domain-specific simulations (SPICE, FEA) rather than MCQ or LLM-as-a-Judge. Results are verifiable against ground truth, making it resistant to the format exploitation that plagues most reasoning benchmarks. EngDesign-Open provides 53 fully open-sourced tasks on HuggingFace.}
}

@inproceedings{kulkarni2025massiveagents,
  title     = {MASSIVE-Agents: A Benchmark for Multilingual Function-Calling in 52 Languages},
  author    = {Kulkarni, Mayank and Mazzia, V. and Gaspers, J. and Hench, C. and FitzGerald, J.},
  booktitle = {Findings of the Association for Computational Linguistics: EMNLP 2025},
  year      = {2025},
  tags      = {evaluation, tool use, multilingual},
  abstract  = {Tool-use generalization is far more fragile than English-centric benchmarks suggest. MASSIVE-Agents exposes this by evaluating function-calling across 52 languages, revealing systematic performance degradation when English scaffolding is removed. The benchmark covers diverse API structures and argument types, forcing models to genuinely read context rather than pattern-match on familiar prompt formats.}
}

